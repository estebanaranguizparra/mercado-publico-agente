# --- Claude API ---
# Requerido para el paso de análisis. Alternativa: `ant auth login`.
ANTHROPIC_API_KEY=

# Modelo y profundidad de razonamiento.
MP_MODELO=claude-opus-5
# low | medium | high | xhigh | max
MP_EFFORT=high

# --- Mercado Público (ChileCompra) ---
# Solicita tu ticket en https://desarrolladores.mercadopublico.cl
# Mientras no lo tengas, deja MP_FUENTE=mock para trabajar con datos de ejemplo.
MP_TICKET=
# mock | api
MP_FUENTE=mock

# Límite de llamadas por minuto a la API de Mercado Público (sé conservador).
MP_REQ_POR_MINUTO=20
MP_TIMEOUT=30

# --- Rutas ---
MP_DB=data/mercadopublico.db
MP_PERFIL=perfil.json
